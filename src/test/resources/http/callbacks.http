# Callbacks go to WireMock on port 7071, on any path with any HTTP method.
# The inbox at http://localhost:7070/callback-logger shows them as they arrive, with their headers, query
# parameters, client IP and body size.

### A JSON payment update, with a request id header
POST http://localhost:7071/callback
Content-Type: application/json
User-Agent: PaymentGateway/2.1
X-Request-Id: VCpcFPowVwzX

{
  "clientId": "wallet_test",
  "requestId": "VCpcFPowVwzX",
  "timestamp": "2023-04-14T09:18:22.132Z",
  "callbackArgs": null,
  "transactions": [
    {
      "transactionId": "m2zMkIcqHXki",
      "transactionType": "pay",
      "statusCode": 100,
      "statusDescription": "The gateway has received the transaction.",
      "statusType": "pending",
      "finished": false
    }
  ],
  "finished": false
}

### An XML update
PUT http://localhost:7071/callback
Content-Type: application/xml

<CATALOG>
    <PLANT>
        <COMMON>Bloodroot</COMMON>
        <BOTANICAL>Sanguinaria canadensis</BOTANICAL>
        <ZONE>4</ZONE>
        <LIGHT>Mostly Shady</LIGHT>
        <PRICE>$2.44</PRICE>
        <AVAILABILITY>031599</AVAILABILITY>
    </PLANT>
    <PLANT>
        <COMMON>Columbine</COMMON>
        <BOTANICAL>Aquilegia canadensis</BOTANICAL>
        <ZONE>3</ZONE>
        <LIGHT>Mostly Shady</LIGHT>
        <PRICE>$9.37</PRICE>
        <AVAILABILITY>030699</AVAILABILITY>
    </PLANT>
    <PLANT>
        <COMMON>Marsh Marigold</COMMON>
        <BOTANICAL>Caltha palustris</BOTANICAL>
        <ZONE>4</ZONE>
        <LIGHT>Mostly Sunny</LIGHT>
        <PRICE>$6.81</PRICE>
        <AVAILABILITY>051799</AVAILABILITY>
    </PLANT>
</CATALOG>

### A JSON status update to a nested path
PATCH http://localhost:7071/orders/42/status
Content-Type: application/json

{
  "orderId": 42,
  "status": "shipped",
  "trackingNumber": "1Z999AA10123456784"
}

### A DELETE with no body
DELETE http://localhost:7071/subscriptions/sub_123

### A GET with a query string, as some webhook verifications send
GET http://localhost:7071/webhook?event=ping&id=123

### A query parameter repeated, which the inbox shows as one row with both values
GET http://localhost:7071/webhook?tag=new&tag=urgent&source=crm

### A GitHub style webhook, with its event, delivery and signature headers
POST http://localhost:7071/github?installation=42
Content-Type: application/json
User-Agent: GitHub-Hookshot/abc1234
X-GitHub-Event: push
X-GitHub-Delivery: 72d3162e-cc78-11e3-81ab-4c9367dc0958
X-Hub-Signature-256: sha256=d57c68ca6f92289e6987922ff26938930f6e66a2d161ef06abdf1859230aa23c

{
  "ref": "refs/heads/main",
  "repository": { "full_name": "leeturner/callback-logger" }
}

### Sent through a proxy: WireMock takes the client IP from X-Forwarded-For
POST http://localhost:7071/proxied
Content-Type: application/json
X-Forwarded-For: 203.0.113.7

{"via": "proxy"}

### A form post
POST http://localhost:7071/payments/notify
Content-Type: application/x-www-form-urlencoded

transaction_id=txn_789&status=completed&amount=19.99

### Plain text with a custom signature header
POST http://localhost:7071/events
Content-Type: text/plain
X-Signature: sha256=5d41402abc4b2a76b9719d911017c592

user.created id=abc123

### A custom method, which Micronaut could not route before
PROPFIND http://localhost:7071/dav/file.txt
Depth: 1

###
